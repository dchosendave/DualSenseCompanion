<UserControl x:Class="DualSenseCompanion.UI.ControllerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Live illustration of a white DualSense-style controller. Pressed inputs light up in lightbar blue. -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="760" Height="470">
            <Canvas.Resources>
                <SolidColorBrush x:Key="Key" Color="#FFFFFF" />
                <SolidColorBrush x:Key="KeyStroke" Color="#C5C9D1" />
                <SolidColorBrush x:Key="Glyph" Color="#9BA0AA" />
                <SolidColorBrush x:Key="CoreKey" Color="#2A2D35" />
            </Canvas.Resources>

            <!-- Triggers (L2/R2) and bumpers (L1/R1), behind the body -->
            <Path x:Name="L2Base" Fill="#1D1F25" Data="M125,74 L125,48 Q125,30 145,30 L225,30 Q245,30 245,48 L245,74 Z" />
            <Path x:Name="L2Fill" Fill="{StaticResource LightbarBrush}" Opacity="0" Data="M125,74 L125,48 Q125,30 145,30 L225,30 Q245,30 245,48 L245,74 Z" />
            <Path x:Name="R2Base" Fill="#1D1F25" Data="M515,74 L515,48 Q515,30 535,30 L615,30 Q635,30 635,48 L635,74 Z" />
            <Path x:Name="R2Fill" Fill="{StaticResource LightbarBrush}" Opacity="0" Data="M515,74 L515,48 Q515,30 535,30 L615,30 Q635,30 635,48 L635,74 Z" />

            <Path x:Name="L1" Fill="#2A2D35" Data="M105,92 L105,72 Q105,58 120,58 L245,58 Q258,58 258,72 L258,92 Z" />
            <Path x:Name="R1" Fill="#2A2D35" Data="M502,92 L502,72 Q502,58 515,58 L640,58 Q655,58 655,72 L655,92 Z" />

            <!-- Body: black core underneath -->
            <Path x:Name="Body" Fill="#101115"
                  Data="M240,70 L520,70 C600,70 640,80 665,110 C700,150 725,230 740,320 C752,390 735,440 690,445 C650,450 625,420 600,380 C570,330 540,300 480,295 L280,295 C220,300 190,330 160,380 C135,420 110,450 70,445 C25,440 8,390 20,320 C35,230 60,150 95,110 C120,80 160,70 240,70 Z">
                <Path.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.22" Color="#000000" />
                </Path.Effect>
            </Path>

            <!-- White shell: top band and both wings -->
            <Path Stroke="#E3E5EA" StrokeThickness="1">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFF" Offset="0" />
                        <GradientStop Color="#F4F5F8" Offset="1" />
                    </LinearGradientBrush>
                </Path.Fill>
                <Path.Data>
                    M240,70 L520,70 C600,70 640,80 665,110 C700,150 725,230 740,320 C752,390 735,440 690,445
                    C662,447 642,430 627,405 C602,360 588,300 578,252 C568,214 548,198 512,197 L248,197
                    C212,198 192,214 182,252 C172,300 158,360 133,405 C118,430 98,447 70,445
                    C25,440 8,390 20,320 C35,230 60,150 95,110 C120,80 160,70 240,70 Z
                </Path.Data>
            </Path>

            <!-- Touchpad -->
            <Rectangle Canvas.Left="258" Canvas.Top="78" Width="244" Height="110" RadiusX="16" RadiusY="16" Fill="#FBFBFC" Stroke="#E3E5EA" StrokeThickness="1.2" />
            <Canvas x:Name="Touchpad" Canvas.Left="258" Canvas.Top="78" Width="244" Height="110">
                <Ellipse x:Name="Touch1" Width="18" Height="18" Fill="{StaticResource AccentBrush}" Opacity="0.85" Visibility="Collapsed" Effect="{StaticResource AccentGlow}" />
                <Ellipse x:Name="Touch2" Width="18" Height="18" Fill="{StaticResource AccentBrush}" Opacity="0.85" Visibility="Collapsed" Effect="{StaticResource AccentGlow}" />
            </Canvas>
            <Rectangle x:Name="TouchpadClick" Canvas.Left="258" Canvas.Top="78" Width="244" Height="110" RadiusX="16" RadiusY="16"
                       Stroke="{StaticResource AccentBrush}" StrokeThickness="3" Visibility="Collapsed" Effect="{StaticResource AccentGlow}" />

            <!-- Lightbar strips along the touchpad -->
            <Path x:Name="LightbarLeft" Stroke="#2F6BFF" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M249,90 C244,118 244,150 249,178">
                <Path.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="1" Color="#2F6BFF" />
                </Path.Effect>
            </Path>
            <Path x:Name="LightbarRight" Stroke="#2F6BFF" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M511,90 C516,118 516,150 511,178">
                <Path.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="1" Color="#2F6BFF" />
                </Path.Effect>
            </Path>

            <!-- Create / Options -->
            <Rectangle x:Name="Create" Canvas.Left="222" Canvas.Top="92" Width="12" Height="28" RadiusX="6" RadiusY="6" Fill="{StaticResource Key}" Stroke="{StaticResource KeyStroke}" StrokeThickness="1.4" />
            <Rectangle x:Name="Options" Canvas.Left="526" Canvas.Top="92" Width="12" Height="28" RadiusX="6" RadiusY="6" Fill="{StaticResource Key}" Stroke="{StaticResource KeyStroke}" StrokeThickness="1.4" />

            <!-- D-pad -->
            <Path x:Name="DpadUp" Fill="{StaticResource Key}" Stroke="{StaticResource KeyStroke}" StrokeThickness="1.4" Data="M139,138 Q139,132 145,132 L157,132 Q163,132 163,138 L163,158 L151,170 L139,158 Z" />
            <Path x:Name="DpadDown" Fill="{StaticResource Key}" Stroke="{StaticResource KeyStroke}" StrokeThickness="1.4" Data="M139,212 Q139,218 145,218 L157,218 Q163,218 163,212 L163,192 L151,180 L139,192 Z" />
            <Path x:Name="DpadLeft" Fill="{StaticResource Key}" Stroke="{StaticResource KeyStroke}" StrokeThickness="1.4" Data="M114,163 Q108,163 108,169 L108,181 Q108,187 114,187 L134,187 L146,175 L134,163 Z" />
            <Path x:Name="DpadRight" Fill="{StaticResource Key}" Stroke="{StaticResource KeyStroke}" StrokeThickness="1.4" Data="M188,163 Q194,163 194,169 L194,181 Q194,187 188,187 L168,187 L156,175 L168,163 Z" />

            <!-- Face buttons -->
            <Ellipse x:Name="Triangle" Canvas.Left="592" Canvas.Top="122" Width="36" Height="36" Fill="{StaticResource Key}" Stroke="{StaticResource KeyStroke}" StrokeThickness="1.4" />
            <Path x:Name="TriangleGlyph" Stroke="{StaticResource Glyph}" StrokeThickness="1.8" StrokeLineJoin="Round" Data="M610,131 L619,146 L601,146 Z" />

            <Ellipse x:Name="Circle" Canvas.Left="627" Canvas.Top="157" Width="36" Height="36" Fill="{StaticResource Key}" Stroke="{StaticResource KeyStroke}" StrokeThickness="1.4" />
            <Ellipse x:Name="CircleGlyph" Canvas.Left="636" Canvas.Top="166" Width="18" Height="18" Stroke="{StaticResource Glyph}" StrokeThickness="1.8" />

            <Ellipse x:Name="Cross" Canvas.Left="592" Canvas.Top="192" Width="36" Height="36" Fill="{StaticResource Key}" Stroke="{StaticResource KeyStroke}" StrokeThickness="1.4" />
            <Path x:Name="CrossGlyph" Stroke="{StaticResource Glyph}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M602,202 L618,218 M618,202 L602,218" />

            <Ellipse x:Name="Square" Canvas.Left="557" Canvas.Top="157" Width="36" Height="36" Fill="{StaticResource Key}" Stroke="{StaticResource KeyStroke}" StrokeThickness="1.4" />
            <Rectangle x:Name="SquareGlyph" Canvas.Left="567" Canvas.Top="167" Width="16" Height="16" Stroke="{StaticResource Glyph}" StrokeThickness="1.8" />

            <!-- Player LEDs, just under the touchpad -->
            <StackPanel x:Name="PlayerLeds" Orientation="Horizontal" Canvas.Left="345" Canvas.Top="205">
                <Rectangle Width="10" Height="3" RadiusX="1.5" RadiusY="1.5" Margin="2,0" Fill="#2C2F37" />
                <Rectangle Width="10" Height="3" RadiusX="1.5" RadiusY="1.5" Margin="2,0" Fill="#2C2F37" />
                <Rectangle Width="10" Height="3" RadiusX="1.5" RadiusY="1.5" Margin="2,0" Fill="#2C2F37" />
                <Rectangle Width="10" Height="3" RadiusX="1.5" RadiusY="1.5" Margin="2,0" Fill="#2C2F37" />
                <Rectangle Width="10" Height="3" RadiusX="1.5" RadiusY="1.5" Margin="2,0" Fill="#2C2F37" />
            </StackPanel>

            <!-- Speaker grille -->
            <Path Fill="#2C2F37" Data="M366,224 a1.6,1.6 0 1 0 0.1,0 M374,224 a1.6,1.6 0 1 0 0.1,0 M382,224 a1.6,1.6 0 1 0 0.1,0 M390,224 a1.6,1.6 0 1 0 0.1,0 M370,230 a1.6,1.6 0 1 0 0.1,0 M378,230 a1.6,1.6 0 1 0 0.1,0 M386,230 a1.6,1.6 0 1 0 0.1,0" />

            <!-- Sticks -->
            <Ellipse Canvas.Left="259" Canvas.Top="212" Width="72" Height="72" Fill="#08090B" Stroke="#2C2F37" StrokeThickness="1.5" />
            <Canvas x:Name="LeftStick" Canvas.Left="295" Canvas.Top="248">
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="LeftStickMove" />
                </Canvas.RenderTransform>
                <Ellipse x:Name="LeftStickCap" Canvas.Left="-27" Canvas.Top="-27" Width="54" Height="54" Fill="#1F2127" Stroke="#3A3D46" StrokeThickness="2" />
                <Ellipse Canvas.Left="-17" Canvas.Top="-17" Width="34" Height="34" Stroke="#2A2D35" StrokeThickness="1.5" />
            </Canvas>

            <Ellipse Canvas.Left="429" Canvas.Top="212" Width="72" Height="72" Fill="#08090B" Stroke="#2C2F37" StrokeThickness="1.5" />
            <Canvas x:Name="RightStick" Canvas.Left="465" Canvas.Top="248">
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="RightStickMove" />
                </Canvas.RenderTransform>
                <Ellipse x:Name="RightStickCap" Canvas.Left="-27" Canvas.Top="-27" Width="54" Height="54" Fill="#1F2127" Stroke="#3A3D46" StrokeThickness="2" />
                <Ellipse Canvas.Left="-17" Canvas.Top="-17" Width="34" Height="34" Stroke="#2A2D35" StrokeThickness="1.5" />
            </Canvas>

            <!-- Home and mute buttons -->
            <Ellipse x:Name="PsButton" Canvas.Left="368" Canvas.Top="243" Width="24" Height="24" Fill="{StaticResource CoreKey}" Stroke="#3A3D46" StrokeThickness="1.2" />
            <Rectangle x:Name="MuteButton" Canvas.Left="369" Canvas.Top="277" Width="22" Height="7" RadiusX="3.5" RadiusY="3.5" Fill="{StaticResource CoreKey}" />
        </Canvas>
    </Viewbox>
</UserControl>
