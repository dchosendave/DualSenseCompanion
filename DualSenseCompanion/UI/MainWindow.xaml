<Window x:Class="DualSenseCompanion.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DualSense Companion"
        Width="1040" Height="700" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        FontFamily="{StaticResource UiFont}"
        Icon="pack://application:,,,/DualSenseCompanion;component/icon_6Q2_icon.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: the black core -->
        <Border Background="{StaticResource ShellBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,14,16,14">
                    <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="15" Foreground="{StaticResource TextBrush}">
                        <Run Text="DualSense" FontWeight="SemiBold" /><Run Text=" Companion" Foreground="{StaticResource TextSecondaryBrush}" />
                    </TextBlock>
                    <Border Height="2" Width="28" CornerRadius="1" HorizontalAlignment="Left" Margin="0,8,0,0"
                            Background="{StaticResource AccentBrush}" />
                </StackPanel>

                <!-- Connection status -->
                <Border DockPanel.Dock="Bottom" Padding="16,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#5B5F69" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock x:Name="StatusTitle" Text="Not connected" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="12.5" />
                        </StackPanel>
                        <TextBlock x:Name="StatusDetail" Text="Plug in or pair your controller" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="14,1,0,0" TextWrapping="Wrap" />
                        <Grid x:Name="StatusBatteryRow" Margin="14,6,0,0" Visibility="Collapsed">
                            <Border Height="3" CornerRadius="1.5" Background="{StaticResource TrackBrush}" />
                            <Border x:Name="StatusBatteryFill" Height="3" CornerRadius="1.5" HorizontalAlignment="Left" Width="0" Background="{StaticResource AccentBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="Nav">
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="Home" x:Name="NavHome" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE706;" Content="Lightbar &amp; LEDs" x:Name="NavLightbar" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE7FC;" Content="Sticks" x:Name="NavSticks" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE945;" Content="Adaptive triggers" x:Name="NavTriggers" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE7AD;" Content="Gyro aiming" x:Name="NavGyro" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE720;" Content="Touchpad &amp; mic" x:Name="NavTouchpad" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE8AB;" Content="Button mapping" x:Name="NavButtons" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Settings" x:Name="NavSettings" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE9D9;" Content="Log" x:Name="NavLog" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content: the white shell -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <!-- Title bar buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" />
                <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize" />
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close to tray" />
            </StackPanel>

            <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,20,16" Focusable="False">
                <ContentControl x:Name="PageHost" MaxWidth="920" HorizontalAlignment="Stretch" Focusable="False" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
