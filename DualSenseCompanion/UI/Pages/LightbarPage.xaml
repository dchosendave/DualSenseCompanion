<UserControl x:Class="DualSenseCompanion.UI.Pages.LightbarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:DualSenseCompanion.UI">
    <UserControl.Resources>
        <ui:EqualsConverter x:Key="Is" />
        <ui:BoolToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Lightbar &amp; LEDs" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="Changes show on your controller instantly." />

        <Border Visibility="{Binding IsNative, Converter={StaticResource Visible}}" Margin="0,10,0,0" Padding="10,7"
                Background="{DynamicResource WarningBackBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="4">
            <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource WarningTextBrush}"
                       Text="Native DualSense mode is on, so games control the lightbar, triggers and rumble. Changes here are sent right away, but a game can override them. Pick Xbox or DS4 on the Home page to keep them." />
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,10">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="Lightbar" />
                <TextBlock Style="{StaticResource Caption}" Text="What the light strips around the touchpad show." />
                <Border Style="{StaticResource SegmentHost}" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="LbMode" Content="Color" IsChecked="{Binding LightbarMode, Converter={StaticResource Is}, ConverterParameter=Static}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="LbMode" Content="Breathing" IsChecked="{Binding LightbarMode, Converter={StaticResource Is}, ConverterParameter=Breathing}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="LbMode" Content="Rainbow" IsChecked="{Binding LightbarMode, Converter={StaticResource Is}, ConverterParameter=Rainbow}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="LbMode" Content="Music" IsChecked="{Binding LightbarMode, Converter={StaticResource Is}, ConverterParameter=AudioReactive}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="LbMode" Content="Battery level" IsChecked="{Binding LightbarMode, Converter={StaticResource Is}, ConverterParameter=Battery}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="LbMode" Content="Set by game" IsChecked="{Binding LightbarMode, Converter={StaticResource Is}, ConverterParameter=Game}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="LbMode" Content="Off" IsChecked="{Binding LightbarMode, Converter={StaticResource Is}, ConverterParameter=Off}" />
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="Breathing fades your color in and out. Rainbow cycles through every color. Music pulses your color with whatever your PC is playing. Battery level goes from green to red. Set by game works in DualShock 4 mode." />
                <StackPanel Visibility="{Binding ShowEffectSpeed, Converter={StaticResource Visible}}" Margin="0,8,0,0">
                    <Grid>
                        <TextBlock Style="{StaticResource Label}" Text="Effect speed" />
                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding LightbarEffectSpeed, StringFormat={}{0:0.0}x}" />
                    </Grid>
                    <Slider AutomationProperties.Name="Effect speed" Minimum="0.2" Maximum="3" Value="{Binding LightbarEffectSpeed}" />
                </StackPanel>
                <CheckBox Style="{StaticResource Toggle}" AutomationProperties.Name="Pulse red while the mic is muted" IsChecked="{Binding PulseRedWhenMicMuted}" Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="Pulse red while the mic is muted" />
                        <TextBlock Style="{StaticResource Caption}" Text="A reminder you're muted. Needs the mute button feature on the Touchpad &amp; mic page." />
                    </StackPanel>
                </CheckBox>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="132" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <!-- Preview: a glowing lightbar strip on the black core -->
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Margin="0,0,16,0" Height="132" VerticalAlignment="Top">
                    <Grid>
                        <Border Width="8" Height="76" CornerRadius="4" Background="{Binding LightbarPreview}" HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="1" Color="{Binding LightbarPreview.Color}" />
                            </Border.Effect>
                        </Border>
                        <TextBlock Text="{Binding LightbarHex}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" Typography.NumeralAlignment="Tabular"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource CardTitle}" Text="Color" />
                    <WrapPanel x:Name="Swatches" Margin="0,4,0,2" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="R" FontWeight="SemiBold" Foreground="#EF4444" />
                        <Slider AutomationProperties.Name="Lightbar red" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding LightbarRed}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding LightbarRed}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="G" FontWeight="SemiBold" Foreground="#22C55E" />
                        <Slider AutomationProperties.Name="Lightbar green" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding LightbarGreen}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding LightbarGreen}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="B" FontWeight="SemiBold" Foreground="#2F6BFF" />
                        <Slider AutomationProperties.Name="Lightbar blue" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding LightbarBlue}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding LightbarBlue}" />
                    </Grid>

                    <Button Style="{StaticResource SecondaryButton}" Content="More colors..." Margin="0,4,0,0" Click="MoreColors_Click" />

                    <Grid Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource Label}" Text="Brightness" />
                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding LightbarBrightness, StringFormat={}{0:0}%}" />
                    </Grid>
                    <Slider AutomationProperties.Name="Lightbar brightness" Minimum="5" Maximum="100" Value="{Binding LightbarBrightness}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="Player LEDs" />
                <TextBlock Style="{StaticResource Caption}" Text="The small lights under the touchpad." />
                <Border Style="{StaticResource SegmentHost}" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="Player" Content="Off" IsChecked="{Binding PlayerNumber, Converter={StaticResource Is}, ConverterParameter=0}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Player" Content="Player 1" IsChecked="{Binding PlayerNumber, Converter={StaticResource Is}, ConverterParameter=1}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Player" Content="Player 2" IsChecked="{Binding PlayerNumber, Converter={StaticResource Is}, ConverterParameter=2}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Player" Content="Player 3" IsChecked="{Binding PlayerNumber, Converter={StaticResource Is}, ConverterParameter=3}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Player" Content="Player 4" IsChecked="{Binding PlayerNumber, Converter={StaticResource Is}, ConverterParameter=4}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Player" Content="All" IsChecked="{Binding PlayerNumber, Converter={StaticResource Is}, ConverterParameter=5}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="Low battery" />
                <Grid Margin="0,6,0,0">
                    <TextBlock Style="{StaticResource Label}" Text="Warn when battery is at or below" />
                    <TextBlock Style="{StaticResource ValueText}" Text="{Binding LowBatteryThreshold, StringFormat={}{0:0}%}" />
                </Grid>
                <Slider AutomationProperties.Name="Warn when battery is at or below" Minimum="5" Maximum="50" Value="{Binding LowBatteryThreshold}" />
                <CheckBox Style="{StaticResource Toggle}" Content="Pulse the lightbar red" IsChecked="{Binding PulseWhenLow}" Margin="0,6,0,0" />
                <CheckBox Style="{StaticResource Toggle}" Content="Show a notification" IsChecked="{Binding NotifyWhenLow}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
