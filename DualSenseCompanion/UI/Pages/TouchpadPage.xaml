<UserControl x:Class="DualSenseCompanion.UI.Pages.TouchpadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Touchpad &amp; mic" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="Use the touchpad as a mouse and the mute button for your Windows microphone." />

        <Border Style="{StaticResource Card}" Margin="0,12,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource CardTitle}" Text="Touchpad" />
                    <CheckBox Style="{StaticResource Toggle}" AutomationProperties.Name="Use as a mouse" IsChecked="{Binding TouchpadMouse}" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="Use as a mouse" />
                            <TextBlock Style="{StaticResource Caption}" Text="One finger moves the pointer, click is left click, click with two fingers is right click." />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Toggle}" AutomationProperties.Name="Two-finger scroll" IsChecked="{Binding TouchpadScroll}" IsEnabled="{Binding TouchpadMouse}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="Two-finger scroll" />
                            <TextBlock Style="{StaticResource Caption}" Text="Drag two fingers up or down to scroll." />
                        </StackPanel>
                    </CheckBox>
                    <StackPanel IsEnabled="{Binding TouchpadMouse}" Margin="0,6,0,0">
                        <Grid><TextBlock Style="{StaticResource Label}" Text="Pointer speed" /><TextBlock Style="{StaticResource ValueText}" Text="{Binding TouchpadSensitivity, StringFormat={}{0:0.0}x}" /></Grid>
                        <Slider AutomationProperties.Name="Pointer speed" Minimum="0.2" Maximum="4" Value="{Binding TouchpadSensitivity}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="When off, the touchpad click goes to the game (DualShock 4 mode gets the full touchpad)." />
                </StackPanel>

                <!-- Live touchpad -->
                <Border Grid.Column="1" Height="120" VerticalAlignment="Top" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5">
                    <Grid>
                        <Border x:Name="ClickRing" CornerRadius="10" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3" Visibility="Collapsed" Effect="{StaticResource AccentGlow}" />
                        <Canvas x:Name="Pad" ClipToBounds="True">
                            <Ellipse x:Name="Finger1" Width="18" Height="18" Fill="{DynamicResource AccentBrush}" Opacity="0.85" Visibility="Collapsed" Effect="{StaticResource AccentGlow}" />
                            <Ellipse x:Name="Finger2" Width="18" Height="18" Fill="{DynamicResource AccentBrush}" Opacity="0.85" Visibility="Collapsed" Effect="{StaticResource AccentGlow}" />
                        </Canvas>
                        <TextBlock x:Name="PadHint" Text="Touch the touchpad" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Mute button" />
                    <CheckBox Style="{StaticResource Toggle}" AutomationProperties.Name="Mute and unmute Windows microphones" IsChecked="{Binding MicMuteButton}" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="Mute and unmute Windows microphones" />
                            <TextBlock Style="{StaticResource Caption}" Text="The button glows orange while muted. Works in Discord, Teams and games." />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
                <Border Grid.Column="1" Margin="16,0,0,0" Padding="12,7" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="MicLed" Width="26" Height="8" CornerRadius="4" Background="{DynamicResource TrackBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="MicText" Text="Microphone on" Foreground="{DynamicResource TextBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
