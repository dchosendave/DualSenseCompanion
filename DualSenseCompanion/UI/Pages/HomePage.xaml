<UserControl x:Class="DualSenseCompanion.UI.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:DualSenseCompanion.UI">
    <UserControl.Resources>
        <ui:EqualsConverter x:Key="Is" />
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Your controller" />
        <TextBlock x:Name="Subtitle" Style="{StaticResource PageSubtitle}" Text="Press any button to see it light up." />

        <!-- Live controller -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,10" Padding="12,14">
            <Grid>
                <ui:ControllerView x:Name="Controller" Height="300" />
                <Border x:Name="ConnectHint" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,0"
                        Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE839;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Connect your controller with a USB cable or Bluetooth" Foreground="{StaticResource TextBrush}" FontSize="12.5" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <UniformGrid Columns="3">
            <!-- Connection -->
            <Border Style="{StaticResource Card}" Margin="0,0,5,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="CONNECTION" FontWeight="SemiBold" />
                    <TextBlock x:Name="ConnectionText" Text="Not connected" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock x:Name="ConnectionDetail" Style="{StaticResource Caption}" Text="Waiting for a DualSense" />
                </StackPanel>
            </Border>

            <!-- Battery -->
            <Border Style="{StaticResource Card}" Margin="5,0,5,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="BATTERY" FontWeight="SemiBold" />
                    <TextBlock x:Name="BatteryText" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,6" />
                    <Grid x:Name="BatteryBar" Height="4">
                        <Border CornerRadius="2" Background="{StaticResource TrackBrush}" />
                        <Border x:Name="BatteryFill" CornerRadius="2" HorizontalAlignment="Left" Width="0" Background="{StaticResource AccentBrush}" />
                    </Grid>
                    <TextBlock x:Name="BatteryDetail" Style="{StaticResource Caption}" Margin="0,4,0,0" Text="Shown once connected" />
                </StackPanel>
            </Border>

            <!-- Emulation -->
            <Border Style="{StaticResource Card}" Margin="5,0,0,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="GAMES SEE A" FontWeight="SemiBold" />
                    <Border Style="{StaticResource SegmentHost}" Margin="0,6,0,6">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" GroupName="HomeEmulation" Content="Xbox"
                                         IsChecked="{Binding Emulation, Converter={StaticResource Is}, ConverterParameter=Xbox360}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="HomeEmulation" Content="DS4"
                                         IsChecked="{Binding Emulation, Converter={StaticResource Is}, ConverterParameter=DualShock4}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="HomeEmulation" Content="DualSense"
                                         IsChecked="{Binding Emulation, Converter={StaticResource Is}, ConverterParameter=Native}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Caption}" Text="Xbox works everywhere. DualShock 4 adds gyro and touchpad. DualSense is for games with built-in DualSense support." />
                </StackPanel>
            </Border>
        </UniformGrid>
    </StackPanel>
</UserControl>
