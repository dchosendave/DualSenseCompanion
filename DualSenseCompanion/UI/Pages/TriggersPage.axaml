<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:DualSenseCompanion.UI"
             x:Class="DualSenseCompanion.UI.Pages.TriggersPage">
  <UserControl.Resources>
    <ui:EqualsConverter x:Key="Is" />
  </UserControl.Resources>

  <StackPanel>
    <TextBlock Classes="pageTitle" Text="Adaptive triggers" />
    <TextBlock Classes="pageSubtitle" Text="Pick an effect and pull the trigger to feel it. It applies right away and stays on in every game." />
    <Border Classes="notice" Margin="0,10,0,0" IsVisible="{Binding IsNative}">
      <TextBlock FontSize="12" TextWrapping="Wrap" Text="Native DualSense mode is on, so games control the lightbar, triggers and rumble. Changes here are sent right away, but a game can override them. Pick Xbox or DS4 on the Home page to keep them." />
    </Border>

    <Grid ColumnDefinitions="*,*" Margin="0,12,0,0">
      <Border Classes="section" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Classes="cardTitle" Text="L2" />
          <Grid Name="L2Bar" Height="4" Margin="0,4,0,10">
            <Border Classes="track" />
            <Border Name="L2Fill" Classes="fill" Width="0" />
          </Grid>
          <RadioButton Classes="tile" GroupName="L2" AutomationProperties.Name="L2: Off"
                       IsChecked="{Binding LeftTriggerEffect, Converter={StaticResource Is}, ConverterParameter=Off}">
            <StackPanel><TextBlock Text="Off" FontWeight="SemiBold" /><TextBlock Classes="caption" Text="Normal trigger, no resistance." /></StackPanel>
          </RadioButton>
          <RadioButton Classes="tile" GroupName="L2" AutomationProperties.Name="L2: Soft resistance"
                       IsChecked="{Binding LeftTriggerEffect, Converter={StaticResource Is}, ConverterParameter=Soft}">
            <StackPanel><TextBlock Text="Soft resistance" FontWeight="SemiBold" /><TextBlock Classes="caption" Text="A light push-back for most of the pull." /></StackPanel>
          </RadioButton>
          <RadioButton Classes="tile" GroupName="L2" AutomationProperties.Name="L2: Medium resistance"
                       IsChecked="{Binding LeftTriggerEffect, Converter={StaticResource Is}, ConverterParameter=Medium}">
            <StackPanel><TextBlock Text="Medium resistance" FontWeight="SemiBold" /><TextBlock Classes="caption" Text="Noticeably firmer, good for driving games." /></StackPanel>
          </RadioButton>
          <RadioButton Classes="tile" GroupName="L2" AutomationProperties.Name="L2: Hard resistance"
                       IsChecked="{Binding LeftTriggerEffect, Converter={StaticResource Is}, ConverterParameter=Hard}">
            <StackPanel><TextBlock Text="Hard resistance" FontWeight="SemiBold" /><TextBlock Classes="caption" Text="Strong resistance through the whole pull." /></StackPanel>
          </RadioButton>
          <RadioButton Classes="tile" GroupName="L2" AutomationProperties.Name="L2: Weapon"
                       IsChecked="{Binding LeftTriggerEffect, Converter={StaticResource Is}, ConverterParameter=Weapon}">
            <StackPanel><TextBlock Text="Weapon" FontWeight="SemiBold" /><TextBlock Classes="caption" Text="Resists, then breaks with a click at mid-pull." /></StackPanel>
          </RadioButton>
          <RadioButton Classes="tile" GroupName="L2" AutomationProperties.Name="L2: Vibrate"
                       IsChecked="{Binding LeftTriggerEffect, Converter={StaticResource Is}, ConverterParameter=Vibrate}">
            <StackPanel><TextBlock Text="Vibrate" FontWeight="SemiBold" /><TextBlock Classes="caption" Text="The trigger buzzes once pulled past a quarter." /></StackPanel>
          </RadioButton>
        </StackPanel>
      </Border>
      <Grid Grid.Column="1">
      <Border Classes="section" Margin="12,0,0,0">
        <StackPanel>
          <TextBlock Classes="cardTitle" Text="R2" />
          <Grid Name="R2Bar" Height="4" Margin="0,4,0,10">
            <Border Classes="track" />
            <Border Name="R2Fill" Classes="fill" Width="0" />
          </Grid>
          <RadioButton Classes="tile" GroupName="R2" AutomationProperties.Name="R2: Off"
                       IsChecked="{Binding RightTriggerEffect, Converter={StaticResource Is}, ConverterParameter=Off}">
            <StackPanel><TextBlock Text="Off" FontWeight="SemiBold" /><TextBlock Classes="caption" Text="Normal trigger, no resistance." /></StackPanel>
          </RadioButton>
          <RadioButton Classes="tile" GroupName="R2" AutomationProperties.Name="R2: Soft resistance"
                       IsChecked="{Binding RightTriggerEffect, Converter={StaticResource Is}, ConverterParameter=Soft}">
            <StackPanel><TextBlock Text="Soft resistance" FontWeight="SemiBold" /><TextBlock Classes="caption" Text="A light push-back for most of the pull." /></StackPanel>
          </RadioButton>
          <RadioButton Classes="tile" GroupName="R2" AutomationProperties.Name="R2: Medium resistance"
                       IsChecked="{Binding RightTriggerEffect, Converter={StaticResource Is}, ConverterParameter=Medium}">
            <StackPanel><TextBlock Text="Medium resistance" FontWeight="SemiBold" /><TextBlock Classes="caption" Text="Noticeably firmer, good for driving games." /></StackPanel>
          </RadioButton>
          <RadioButton Classes="tile" GroupName="R2" AutomationProperties.Name="R2: Hard resistance"
                       IsChecked="{Binding RightTriggerEffect, Converter={StaticResource Is}, ConverterParameter=Hard}">
            <StackPanel><TextBlock Text="Hard resistance" FontWeight="SemiBold" /><TextBlock Classes="caption" Text="Strong resistance through the whole pull." /></StackPanel>
          </RadioButton>
          <RadioButton Classes="tile" GroupName="R2" AutomationProperties.Name="R2: Weapon"
                       IsChecked="{Binding RightTriggerEffect, Converter={StaticResource Is}, ConverterParameter=Weapon}">
            <StackPanel><TextBlock Text="Weapon" FontWeight="SemiBold" /><TextBlock Classes="caption" Text="Resists, then breaks with a click at mid-pull." /></StackPanel>
          </RadioButton>
          <RadioButton Classes="tile" GroupName="R2" AutomationProperties.Name="R2: Vibrate"
                       IsChecked="{Binding RightTriggerEffect, Converter={StaticResource Is}, ConverterParameter=Vibrate}">
            <StackPanel><TextBlock Text="Vibrate" FontWeight="SemiBold" /><TextBlock Classes="caption" Text="The trigger buzzes once pulled past a quarter." /></StackPanel>
          </RadioButton>
        </StackPanel>
      </Border>
      </Grid>
    </Grid>
  </StackPanel>
</UserControl>
