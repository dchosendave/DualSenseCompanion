<UserControl x:Class="DualSenseCompanion.UI.Pages.LogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Log" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="What the app is doing. Useful when something doesn't work." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Style="{StaticResource SecondaryButton}" Content="Copy" Click="Copy_Click" />
                <Button Style="{StaticResource SecondaryButton}" Content="Open log file" Margin="6,0,0,0" Click="OpenFile_Click" />
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource Card}" Margin="0,12,0,10" Padding="6">
            <TextBox x:Name="LogText" Height="480" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Background="Transparent" BorderThickness="0" Padding="10,6"
                     Foreground="#3A3D46" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
        </Border>
    </StackPanel>
</UserControl>
