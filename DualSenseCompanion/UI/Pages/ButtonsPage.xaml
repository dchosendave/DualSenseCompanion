<UserControl x:Class="DualSenseCompanion.UI.Pages.ButtonsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:DualSenseCompanion.UI">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Button mapping" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="Choose what each DualSense button does on the virtual controller. Press a button to find it in the list." />

        <Border Style="{StaticResource Card}" Margin="0,12,0,10" Padding="6,6">
            <ItemsControl x:Name="Rows" AutomationProperties.Name="Button mapping" ItemsSource="{Binding ButtonMap}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" CornerRadius="6" Padding="10,3" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="230" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource TrackBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Label}" Text="{Binding Name}" />
                                <ComboBox Grid.Column="2" AutomationProperties.Name="{Binding Name}" ItemsSource="{x:Static ui:SettingsViewModel.TargetNames}"
                                          DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Target}" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource SecondaryButton}" Content="Reset to default" Click="Reset_Click" />
            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Text="The mute and touchpad buttons only reach the game when their features (Touchpad &amp; mic page) are turned off." />
        </StackPanel>
    </StackPanel>
</UserControl>
