<UserControl x:Class="DualSenseCompanion.UI.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:DualSenseCompanion.UI">
    <UserControl.Resources>
        <ui:EqualsConverter x:Key="Is" />
        <ui:BoolToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Settings" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="Emulation, rumble and how the app starts." />

        <Border Visibility="{Binding IsNative, Converter={StaticResource Visible}}" Margin="0,10,0,0" Padding="10,7"
                Background="#FFF7E6" BorderBrush="#F5D9A8" BorderThickness="1" CornerRadius="4">
            <TextBlock Style="{StaticResource Caption}" Foreground="#7A5200"
                       Text="Native DualSense mode is on, so games control the lightbar, triggers and rumble. Changes here are sent right away, but a game can override them. Pick Xbox or DS4 on the Home page to keep them." />
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,10">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="Games see a" />
                <Border Style="{StaticResource SegmentHost}" Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="SetEmulation" Content="Xbox 360 controller"
                                     IsChecked="{Binding Emulation, Converter={StaticResource Is}, ConverterParameter=Xbox360}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="SetEmulation" Content="DualShock 4 controller"
                                     IsChecked="{Binding Emulation, Converter={StaticResource Is}, ConverterParameter=DualShock4}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="SetEmulation" Content="Native DualSense"
                                     IsChecked="{Binding Emulation, Converter={StaticResource Is}, ConverterParameter=Native}" />
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                           Text="Xbox 360 works in almost every game. DualShock 4 shows PlayStation button prompts and passes gyro and touchpad to games, emulators and Steam that support them. Native DualSense hands the real controller to games with built-in DualSense support, so they get haptics and their own adaptive trigger effects. The app then stops its own lightbar, trigger and rumble updates, but changes you make here are still sent." />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="Rumble" />
                <Grid Margin="0,6,0,0"><TextBlock Style="{StaticResource Label}" Text="Strength" /><TextBlock Style="{StaticResource ValueText}" Text="{Binding RumbleStrength, StringFormat={}{0:0}%}" /></Grid>
                <Slider Minimum="0" Maximum="100" Value="{Binding RumbleStrength}" />
                <Button Style="{StaticResource SecondaryButton}" Content="Test rumble" Margin="0,4,0,0" Click="TestRumble_Click" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="Self-test" />
                <TextBlock Style="{StaticResource Caption}"
                           Text="Checks that your controller sends input and accepts lightbar, rumble and trigger commands. The lightbar flashes red then green and the controller rumbles briefly. Don't touch the triggers while it runs." />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="SelfTestButton" Style="{StaticResource PrimaryButton}" Content="Run self-test" Click="SelfTest_Click" />
                    <TextBlock x:Name="SelfTestSummary" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <ItemsControl x:Name="SelfTestResults" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Icon}" Foreground="{Binding IconBrush}" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource Label}" Text="{Binding Name}" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Detail}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="Startup" />
                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding StartWithWindows}" Margin="0,10,0,6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="Start with Windows" />
                        <TextBlock Style="{StaticResource Caption}" Text="Starts quietly in the system tray when you sign in." />
                    </StackPanel>
                </CheckBox>
                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding StartMinimized}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="Always start in the tray" />
                        <TextBlock Style="{StaticResource Caption}" Text="Don't open this window when the app starts. Click the tray icon to open it." />
                    </StackPanel>
                </CheckBox>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="Files" />
                <TextBlock Style="{StaticResource Caption}" Text="Settings are saved automatically. You can also edit them by hand and reload." />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Content="Open settings file" Click="OpenSettings_Click" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Reload settings file" Margin="6,0,0,0" Click="ReloadSettings_Click" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Open settings folder" Margin="6,0,0,0" Click="OpenFolder_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Foreground="{StaticResource TextBrush}" Text="About" />
                <TextBlock x:Name="VersionText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="Built on ViGEmBus, HidHide, HidSharp and NAudio. Not affiliated with Sony Interactive Entertainment." />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
