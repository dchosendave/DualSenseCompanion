<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette: white shell, lightbar blue accent. Same keys as Colors.Dark.xaml. -->
    <SolidColorBrush x:Key="ShellBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PageBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F6F7F9" />
    <SolidColorBrush x:Key="HoverBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2F6BFF" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#6C97FF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAF0FF" />
    <SolidColorBrush x:Key="TextBrush" Color="#1D1D1F" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6E6E73" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E5E5EA" />
    <SolidColorBrush x:Key="TrackBrush" Color="#DCDFE5" />
    <SolidColorBrush x:Key="DividerBrush" Color="#C9CCD3" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C9CCD3" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#9EA3AD" />
    <SolidColorBrush x:Key="WarningBackBrush" Color="#FFF7E6" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#F5D9A8" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#7A5200" />
    <SolidColorBrush x:Key="GoodBackBrush" Color="#EAF7EE" />
    <SolidColorBrush x:Key="GoodBorderBrush" Color="#A7D9B5" />
    <SolidColorBrush x:Key="GoodTextBrush" Color="#146C2E" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#2457E0" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1D47BA" />
    <SolidColorBrush x:Key="StatusIdleBrush" Color="#9B9FA8" />
</ResourceDictionary>
