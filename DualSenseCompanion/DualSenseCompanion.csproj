<Project Sdk="Microsoft.NET.Sdk">

  <!-- The app window, tray icon and startup. Everything else lives in DualSenseCompanion.Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DualSenseCompanion</AssemblyName>
    <RootNamespace>DualSenseCompanion</RootNamespace>
    <ApplicationIcon>icon_6Q2_icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Reflection bindings like WPF; the live views update from code, so binding speed does not matter -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- WinForms only for the tray icon, which can show Windows notifications -->
    <UseWindowsForms>true</UseWindowsForms>
    <Product>DualSense Companion</Product>
    <Description>A companion app for the DualSense (PS5) controller on Windows.</Description>
    <Authors>Sar1911</Authors>
  </PropertyGroup>

  <!--
    Release package: one self-contained .exe that runs without installing .NET.
    dotnet publish DualSenseCompanion -c Release -p:SingleFile=true -o publish
    Not trimmed: HidSharp, WMI and the audio COM interop rely on reflection.
  -->
  <PropertyGroup Condition="'$(SingleFile)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <CopyDebugSymbolFilesFromPackages>false</CopyDebugSymbolFilesFromPackages>
    <!-- Only the .exe: no symbol files from native packages next to it -->
    <AllowedReferenceRelatedFileExtensions>.xml</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DualSenseCompanion.Core\DualSenseCompanion.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="icon_6Q2_icon.ico" />
  </ItemGroup>

  <!-- Avalonia and WinForms share type names; import WinForms explicitly where used -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- SkiaSharp and HarfBuzz ship native symbol files that still land next to the .exe; players don't need them -->
  <Target Name="RemoveStraySymbols" AfterTargets="Publish" Condition="'$(SingleFile)' == 'true'">
    <ItemGroup>
      <StraySymbols Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(StraySymbols)" />
  </Target>

</Project>
